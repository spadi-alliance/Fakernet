-- 2023.02.26 100Mbps

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use ieee.std_logic_unsigned.all;

entity fnetrion is
  generic (compiletime : integer := 1);
  port (
    -- On-board clock from PLL 50MHz
    clk100  : in std_logic;
    clk25   : in std_logic;

    -- Ethernet PHY:
    -- Control channel.
    eth_mdc        : out std_logic := '0';
    eth_mdio_in    : in std_logic;
    eth_mdio_out   : out std_logic := '0';
    eth_mdio_oe    : out std_logic := '0';
    eth_rstn       : out std_logic := '1';
    -- TX channel.
    eth_txd        : out std_logic_vector(3 downto 0) := (others => '0');
    eth_tx_en      : out std_logic := '0';
--    eth_gtxclk     : out std_logic; -- defined in inteface deginer
    -- RX channel.
    eth_rxd        : in  std_logic_vector(3 downto 0);
    eth_rx_clk     : in  std_logic;
    eth_rx_dv      : in  std_logic;

    -- User input.
    sw             : in  std_logic_vector(3 downto 0);
    -- sw0 <= dip1, sw1 <= dip2, sw2 <= btn1, sw3 <= btn2
    
    -- LEDs.
    led            : out std_logic_vector(3 downto 0);

    -- UART
    uart_rx        : in  std_logic;
    uart_tx        : out std_logic

    );

end fnetrion;

architecture RTL of fnetrion is


  -------------------------
  -- PHY control signals --
  -------------------------

  signal phy_reset_counter : unsigned(24 downto 0) := (others => '0');

  --------------------------------
  -- Input word builder signals --
  --------------------------------

  signal packet_ended    : std_logic;
  signal words_ready     : std_logic;
  signal first_word      : std_logic_vector(7 downto 0);
  signal second_word     : std_logic_vector(7 downto 0);
  signal packet_start    : std_logic;

  signal packet_counter  : std_logic_vector(3 downto 0) := (others => '0');

  ----------------------
  -- Fakernet signals --
  ----------------------

  -- MAC and IP set manually
  -- 02:00:12:34:20:00
  -- MAC note: low bits of high octet (bits 41..40) "10" is
  -- 'locally administered' and 'unicast'
  constant macaddr : std_logic_vector(47 downto 0) :=
    "00000010" & "00000000" &
    "00010010" & "00110100" & "00100000" & "00000000";
  -- C0A801c0 = 192.168.1.192
  constant ipaddr  : std_logic_vector(31 downto 0) :=
    "11000000" & "10101000" & "00000001" & "11000000";

  -- Data from Fakernet to PHY.
  signal out_word        : std_logic_vector(15 downto 0) :=
    std_logic_vector(to_unsigned(16#dead#,16));
  signal out_ena         : std_logic;
  signal out_payload     : std_logic;
  signal out_taken       : std_logic := '1';
  signal debug_state_in  : std_logic_vector(6 downto 0);
  signal debug_state_out : std_logic_vector(3 downto 0);

  -- Data buffer signals.
  signal data_commit     : std_logic;
  signal data_free       : std_logic;

  -- Slow tick counter every 2^7 = 128 clock cycles = 1.28 us.
  signal slow_counter : std_logic_vector(6 downto 0) := (others => '0');
  signal slow_counter_tick : std_logic := '0';

  -- Timeout tick every 2^26 = 67.1*10^6 clock cycles = 671 ms.
  signal timeout_counter : std_logic_vector(26 downto 0) := (others => '0');
  signal timeout_counter_tick : std_logic := '0';

  -- Register access interface
  signal regacc_addr    : std_logic_vector(24 downto 0);
  signal regacc_data_wr : std_logic_vector(31 downto 0);
  signal regacc_data_rd : std_logic_vector(31 downto 0);
  signal regacc_write   : std_logic;
  signal regacc_read    : std_logic;
  signal regacc_done    : std_logic;
  signal regacc_cnt     : std_logic_vector(3 downto 0);

  -- MDIO interface
  signal mdc_out    : std_logic;
  signal mdc_ena    : std_logic;
  signal mdio_in    : std_logic := '0';
  signal mdio_out   : std_logic;
  signal mdio_ena   : std_logic;

  -----------------------------------------
  -- User button, switch and LED signals --
  -----------------------------------------

  signal sw_latch       : std_logic_vector(3 downto 0);

  ------------------
  -- UART control --
  ------------------

  signal uart_tx_data   : std_logic_vector (7 downto 0) := (others => '0');
  signal uart_tx_taken  : std_logic := '0';
  signal uart_tx_temp   : std_logic := '0';

  signal trace_signals  : std_logic_vector (31 downto 0) := (others => '0');
  signal trace_insert   : std_logic := '0';
  signal trace_trigger  : std_logic := '0';

begin

  ------------------------------
  -- Control reseting the PHY --
  ------------------------------
  process(clk25)
  begin
    if (rising_edge(clk25)) then
      if (phy_reset_counter(phy_reset_counter'high) = '0') then
        phy_reset_counter <= phy_reset_counter + 1;
      end if;
      eth_rstn <=
        phy_reset_counter(phy_reset_counter'high) or
        phy_reset_counter(phy_reset_counter'high-1);
    end if;
  end process;

  -------------------
  -- Data from PHY --
  -------------------

  -- Find start of data and build 16-bit words.
  word_build: entity work.efnet_mii_nibble_to_word
    port map(
      clk              => clk100,
      eth_rx_clk       => eth_rx_clk,
      eth_rx_dv        => eth_rx_dv,
      eth_rxd          => eth_rxd,

      o_word_1         => first_word,
      o_word_2         => second_word,
      o_words_ready    => words_ready,
      o_packet_start   => packet_start,
      o_packet_ended   => packet_ended
      );

  -----------------
  -- Data to PHY --
  -----------------

  -- Emit to 16-bit words as nibbles, based on the PHY tx_clk.
  word_send: entity work.efnet_mii_word_to_nibble
    port map(
      clk              => clk100,
--      eth_tx_clk       => eth_gtxclk,
      eth_tx_clk       => clk25,
      eth_tx_en        => eth_tx_en,
      eth_txd          => eth_txd,

      out_word         => out_word,
      out_ena          => out_ena,
      out_taken        => out_taken
      );

  ----------------------
  -- MDIO to/from PHY --
  ----------------------

  eth_mdc  <= mdc_out;
  eth_mdio_out <= mdio_out;
  eth_mdio_oe <= mdio_ena;

  mdio_in  <= eth_mdio_in;

-- 100Mbps mode
--  eth_gtxclk is defined in interface designer
--  eth_gtxclk <= clk25;
  

  --------------------------------------
  -- Fakernet control/helper signals. --
  --------------------------------------

  -- Counters for slow and timeout tick signals to Fakernet.
  process (clk100)
  begin
    if (rising_edge(clk100)) then
      slow_counter <= slow_counter + 1;
      if (slow_counter = "1111111") then
        slow_counter_tick <= '1';
      else
        slow_counter_tick <= '0';
      end if;

      timeout_counter <= timeout_counter + 1;
      if (timeout_counter = (timeout_counter'range => '0')) then
        timeout_counter_tick <= '1';
      else
        timeout_counter_tick <= '0';
      end if;
    end if;
  end process;

  -- Assign the two low bits of the address from user input switches.
  -- ipaddr(1 downto 0) <= sw_latch(1 downto 0);

  -- We try to commit data into the data buffer every slow tick.
  -- (Note that data is written every cycle.)
  data_commit <= slow_counter_tick and data_free;

  --------------
  -- Fakernet --
  --------------

  fakernet: entity work.fakernet_module
    generic map(data_bufsize_addrbits => 13,
                compiletime => compiletime)
    port map(
      clk             => clk100,
      -- config
      cfg_macaddr     => macaddr,
      cfg_ipaddr      => ipaddr,
      cfg_fixed_ip    => '1',
      cfg_dyn_ip      => '1',
      cfg_gen_rarp    => '1',
      -- Input network traffic
      in_word         => first_word & second_word,
      in_got_word     => words_ready,
      in_new_packet   => packet_start,
      -- Output network traffic
      out_word        => out_word,
      out_taken       => out_taken,
      out_ena         => out_ena,
      out_payload     => out_payload,
      -- MDIO interface
      mdc_out         => mdc_out,
      mdc_ena         => mdc_ena,
      mdio_in         => mdio_in,
      mdio_out        => mdio_out,
      mdio_ena        => mdio_ena,
      -- Register access interface
      reg_addr        => regacc_addr,
      reg_data_wr     => regacc_data_wr,
      reg_data_rd     => regacc_data_rd,
      reg_write       => regacc_write,
      reg_read        => regacc_read,
      reg_done        => regacc_done,
      reg_cnt         => regacc_cnt,
      -- Data input interface
      data_word       => (0 => '1', 31 downto 1 => '0'),
      data_offset     => (9 downto 0 => '0'),
      data_write      => '1',
      data_commit_len => (4 => '1', 7 downto 5 => '0', 3 downto 0 => '0'),
      data_commit     => data_commit,
      data_free       => data_free,
      tcp_reset       => open,
      -- Ticker, to be ~10 times per max length packet send period.
      slow_clock_tick => slow_counter_tick,
      timeout_tick    => timeout_counter_tick,
      -- Debug
      debug_state_in  => debug_state_in,
      debug_state_out => debug_state_out,
      debug_state_regacc => open
      );

  ------------------
  -- UART control --
  ------------------

  trace_signals(15 downto 0) <= first_word & second_word;
  trace_signals(16) <= words_ready;
  trace_signals(17) <= packet_start;
  trace_insert  <= words_ready or packet_start;
  trace_trigger <= packet_start;

  uart_ctrl : entity work.efb_uart_trace_mem
    generic map(
      width => 32,
      samples => 512)
    port map(
      clk             => clk100,
      i_signals       => trace_signals,
      i_insert        => trace_insert,
      i_trigger       => trace_trigger,
      o_data          => uart_tx_data,
      i_taken         => uart_tx_taken
      );

  uart_tx_c : entity work.efb_uart_tx
    port map(
      clk             => clk100,
      --                 125000000/9600:
      i_bit_period    => std_logic_vector(to_unsigned(10416, 16)),
      i_data          => uart_tx_data,
      i_hasdata       => '1', -- uart_tx_2hasdata,
      o_taken         => uart_tx_taken,
      o_tx            => uart_tx_temp
      );

  uart_tx <= not uart_tx_temp;

  ----------------------------
  -- Button and LED control --
  ----------------------------

  process (clk100)
  begin
    if (rising_edge(clk100)) then
      -- Default read value.
      regacc_data_rd <= (others => '0');
      regacc_done <= '0';

      -- Read which switches are selected and which buttons are pressed.
      if (regacc_read = '1' and
          regacc_addr(11 downto 0) = "0000" & "00000001")
      then
        regacc_data_rd <= (31 downto 8 => '0') & sw_latch & "0000";
        regacc_done <= '1';
      end if;

      -- Latch the button and switch values.
      sw_latch <= sw;

      -- Control which LEDs are on.
      if (regacc_write = '1' and
          regacc_addr(11 downto 0) = "0000" & "00000010")
      then
        regacc_done <= '1';
      end if;

      -- Fraction of time control.
      if (regacc_write = '1' and
          regacc_addr(11 downto 0) = "0000" & "00000011")
      then
        regacc_done <= '1';
      end if;

    end if;
  end process;

  -- Count the incoming packets, and show count with user LEDs.
  process (clk100)
  begin
    if (rising_edge(clk100)) then
      if (packet_start = '1') then
        packet_counter <= packet_counter + 1;
      end if;
    end if;
  end process;

  led <= packet_counter;

end RTL;
