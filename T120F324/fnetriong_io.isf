# Create instance
design.create_input_gpio("eth_rxd",3,0)
design.create_output_gpio("eth_txd",3,0)
design.create_output_gpio("led",3,0)
design.create_input_gpio("sw",3,0)
design.create_pll_input_clock_gpio("CLKIN")
design.create_clockout_gpio("eth_gtx_clk")
design.create_output_gpio("eth_mdc")
design.create_inout_gpio("eth_mdio")
design.create_output_gpio("eth_rstn")
design.create_input_clock_gpio("eth_rx_clk")
design.create_input_gpio("eth_rx_dv")
design.create_output_gpio("eth_tx_en")
design.create_input_gpio("uart_rx")
design.create_output_gpio("uart_tx")
design.create_block("CLOCK","PLL")

# Set property, non-defaults
design.set_property("eth_rxd","IN_REG","DDIO_RESYNC")
